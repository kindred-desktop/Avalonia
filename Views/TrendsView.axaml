<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SimpleApp.Desktop.ViewModels"
             xmlns:m="using:SimpleApp.Core.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="SimpleApp.Desktop.Views.TrendsView"
             x:DataType="vm:TrendsViewModel">

    <Design.DataContext>
        <vm:TrendsViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>

                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDevices}"
                         SelectedItem="{Binding SelectedDevice}" Width="200" Margin="0,0,8,0"
                         PlaceholderText="选择设备"/>

                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableTags}"
                         SelectedItem="{Binding SelectedTag}" Width="150" Margin="0,0,8,0"
                         PlaceholderText="选择测点"/>

                <ComboBox Grid.Column="3" ItemsSource="{Binding TimeRanges}"
                         SelectedItem="{Binding SelectedTimeRange}" Width="100" Margin="0,0,16,0"/>

                <Button Grid.Column="4" Content="刷新" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24" RowDefinitions="2*,*">
            <Border Grid.Row="0" Background="White" Padding="24" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="趋势曲线" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <Grid ColumnDefinitions="50,*" RowDefinitions="Auto,*" Height="300">
                        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Stretch">
                            <TextBlock Text="100" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            <Border Background="#E2E8F0" Height="1" Margin="8,0,0,20"/>
                            <TextBlock Text="50" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,0,8,20"/>
                            <Border Background="#E2E8F0" Height="1" Margin="8,0,0,20"/>
                            <TextBlock Text="0" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        </StackPanel>

                        <ItemsControl Grid.Column="1" Grid.Row="0" ItemsSource="{Binding ChartData}" Height="260">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Grid.Column="1" Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                <TextBlock Text="00:00" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="04:00" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="08:00" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="12:00" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="16:00" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="20:00" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" Padding="24" CornerRadius="8" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="实时数据" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding ChartData}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:DataPoint">
                                <Border Background="#F8FAFC" CornerRadius="4" Padding="12" Margin="0,0,8,8" MinWidth="150">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding TagId}" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Value, StringFormat='{}{0:F2}'}" FontSize="20" FontWeight="Bold" Foreground="#2563EB"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
