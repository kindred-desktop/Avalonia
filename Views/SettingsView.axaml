<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SimpleApp.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SimpleApp.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>

            <Border Background="White" CornerRadius="8" Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="通信配置" FontSize="18" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="Modbus IP:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ModbusIp}"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="Modbus Port:" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding ModbusPort}" Minimum="1" Maximum="65535"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="轮询间隔 (ms):" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding PollingInterval}" Minimum="100" Maximum="60000"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="报警配置" FontSize="18" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="历史保留 (天):" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding HistoryRetentionDays}" Minimum="1" Maximum="365"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="启用声音:" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableAlarmSound}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="保存设置" HorizontalAlignment="Stretch" Command="{Binding SaveSettingsCommand}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
