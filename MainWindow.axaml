<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimpleApp.MainWindow"
        Title="简单文本处理工具"
        Width="500"
        Height="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

  <StackPanel Margin="20">
    <TextBlock Text="输入文本：" FontWeight="Bold" FontSize="14"/>
    <TextBox x:Name="InputTextBox" Watermark="请输入要处理的文本..." Height="30"/>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button x:Name="SubmitButton" Content="提交" Width="100" Height="30"/>
      <Button x:Name="ClearButton" Content="清空历史" Width="100" Height="30" Margin="10,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="ResultLabel" Text="结果：" Foreground="Green" FontSize="12" Margin="0,10,0,0"/>
    <TextBlock Text="处理历史：" FontWeight="Bold" FontSize="14" Margin="0,10,0,0"/>
    <TextBox x:Name="HistoryTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="200" Margin="0,5,0,0"/>
  </StackPanel>

</Window>
